{
  "$schema": "http://json.schemastore.org/template",
  "author": "NETWORG",
  "identity": "TALXIS.DevKit.Templates.Dataverse.Connector",
  "name": "Power Platform: Custom Connector",
  "shortName": "pp-connector",
  "description": "Creates a flat Power Platform custom connector project: apiDefinition.swagger.json + apiProperties.json (ProjectType=Connector). Reference it from a Solution project to package it as a Connector solution component.",
  "tags": {
    "language": "JSON",
    "type": "project",
    "componentType": "Connector"
  },
  "sourceName": "ConnectorNameExample",
  "sources": [
    {
      "exclude": [
        "**/[Bb]in/**",
        "**/[Oo]bj/**",
        ".template.config/**/*"
      ]
    }
  ],
  "preferNameDirectory": true,
  "primaryOutputs": [
    {
      "path": "ConnectorNameExample.csproj"
    }
  ],
  "postActions": [
    {
      "description": "Add generated project to .sln file",
      "manualInstructions": [
        {
          "text": "Add generated project to .sln file"
        }
      ],
      "args": {
        "inRoot": true
      },
      "actionId": "D396686C-DE0E-4DE6-906D-291CD29FC5DE",
      "continueOnError": false,
      "primaryOutputIndexes": "0"
    }
  ]
}
